# ===== 基础 =====
# SECRET_KEY=change-me-in-prod
# PORT=8000

# ===== 数据库（默认 SQLite 单机演示；生产 / Docker / CI 切 PostgreSQL）=====
# DATABASE_URL=sqlite+aiosqlite:///./growth_dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growth
# 重建演示库：SEED_RESET=1 python seed.py（SQLite 也可直接删 growth_dev.db）

# ===== LLM（OpenAI 兼容协议；留空则进入离线知识库模式）=====
# DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 通义千问示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== Embedding（RAG 向量化；留空则使用本地 TF-IDF 哈希向量）=====
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ===== 科大讯飞 TTS（可选；留空时前端降级浏览器合成）=====
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
